menu "Bttester configuration"

module = BTTESTER
module-str = bttester
source "subsys/logging/Kconfig.template.log_config"

config Z_API_USE_FRAMEWORK
	bool "Use Framework Bluetooth API for z_api"
	default n
	help
	  When enabled, z_api() functions will be implemented using
	  the Framework Bluetooth API (z_port layer).
	  When disabled, z_api() functions will directly call the
	  original Zephyr Bluetooth API (for Zblue environment).

	  Enable this option when running bttester with the OpenVela
	  Framework Bluetooth stack instead of Zblue.

endmenu

source "Kconfig.zephyr"
