# BR/EDR Controller configuration options

config BT_CTLR_BREDR
	bool "BR/EDR Controller Support"
	depends on BT_CTLR
	help
	  Enable support for BR/EDR Controller in the Bluetooth stack.
	  This implements the BR/EDR Controller as defined in
	  Bluetooth Core Specification Vol 2.

if BT_CTLR_BREDR

config BT_CTLR_BREDR_MAX_CONN
	int "Maximum number of BR/EDR connections"
	default 4
	range 1 7
	help
	  Maximum number of simultaneous BR/EDR ACL connections.

config BT_CTLR_BREDR_SCO_MAX
	int "Maximum number of SCO connections"
	default 2
	range 0 3
	help
	  Maximum number of simultaneous SCO connections.

config BT_CTLR_BREDR_ESCO_MAX
	int "Maximum number of eSCO connections"
	default 2
	range 0 3
	help
	  Maximum number of simultaneous eSCO connections.

config BT_CTLR_BREDR_INQUIRY
	bool "BR/EDR Inquiry Support"
	default y
	help
	  Enable support for BR/EDR Inquiry procedure.

config BT_CTLR_BREDR_PAGE
	bool "BR/EDR Paging Support"
	default y
	help
	  Enable support for BR/EDR Paging procedure.

config BT_CTLR_BREDR_PAGE_SCAN
	bool "BR/EDR Page Scan Support"
	default y
	help
	  Enable support for BR/EDR Page Scan procedure.

config BT_CTLR_BREDR_INQUIRY_SCAN
	bool "BR/EDR Inquiry Scan Support"
	default y
	help
	  Enable support for BR/EDR Inquiry Scan procedure.

config BT_CTLR_BREDR_EIR
	bool "BR/EDR Extended Inquiry Response"
	default y
	help
	  Enable support for Extended Inquiry Response.

config BT_CTLR_BREDR_SSP
	bool "BR/EDR Secure Simple Pairing"
	default y
	help
	  Enable support for Secure Simple Pairing.

config BT_CTLR_BREDR_EDR
	bool "BR/EDR Enhanced Data Rate"
	default y
	help
	  Enable support for Enhanced Data Rate (2 Mbps and 3 Mbps).

config BT_CTLR_BREDR_AFH
	bool "BR/EDR Adaptive Frequency Hopping"
	default y
	help
	  Enable support for Adaptive Frequency Hopping.

config BT_CTLR_BREDR_SNIFF
	bool "BR/EDR Sniff Mode"
	default y
	help
	  Enable support for Sniff mode power saving.

config BT_CTLR_BREDR_HOLD
	bool "BR/EDR Hold Mode"
	default n
	help
	  Enable support for Hold mode.

config BT_CTLR_BREDR_PARK
	bool "BR/EDR Park Mode"
	default n
	help
	  Enable support for Park mode.

config BT_CTLR_BREDR_ROLE_SWITCH
	bool "BR/EDR Role Switch"
	default y
	help
	  Enable support for Central/Peripheral role switch.

config BT_CTLR_BREDR_TX_BUFFERS
	int "Number of BR/EDR TX buffers"
	default 4
	range 1 16
	help
	  Number of TX buffers for BR/EDR ACL data.

config BT_CTLR_BREDR_RX_BUFFERS
	int "Number of BR/EDR RX buffers"
	default 4
	range 1 16
	help
	  Number of RX buffers for BR/EDR ACL data.

endif # BT_CTLR_BREDR
